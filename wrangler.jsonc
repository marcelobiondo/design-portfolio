{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "design-portfolio",
  "compatibility_date": "2026-08-17",

  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  "env": {
    "dev": {
      "name": "design-portfolio-dev"
    }
  }
}
